OCR_IMAGE=xiaosongshu-ppocrv6:3.7.0
OCR_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
OCR_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
OCR_PLATFORM=linux/amd64
OCR_PORT=8019

# Set this to the parent directory that already contains both model folders.
# OCR_MODEL_HOST_DIR=/absolute/path/to/.paddlex/official_models
OCR_DETECTION_MODEL_NAME=PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL_NAME=PP-OCRv6_medium_rec
OCR_DEVICE=cpu
OCR_ENABLE_MKLDNN=false
OCR_MAX_INPUT_BYTES=52428800
OCR_MAX_PDF_PAGES=5
OCR_PDF_DPI=180
OCR_PDF_MAX_SIDE=2400
OCR_MIN_SCORE=0.45
